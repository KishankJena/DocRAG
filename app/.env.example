# ============================================================
# PDF Chatbot - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Model Settings ---
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# --- Chroma DB ---
# Path where ChromaDB will persist data
CHROMA_DB_PATH=./chroma_db

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Chunking Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval Settings ---
# How many relevant chunks to retrieve per query
TOP_K_RESULTS=4

# --- Optional: Llama / Local LLM ---
# Set to "true" to use a local Llama model instead of OpenAI
USE_LOCAL_LLM=false
# Path to your local GGUF model file (e.g., llama-2-7b-chat.Q4_K_M.gguf)
LOCAL_MODEL_PATH=./models/llama-2-7b-chat.Q4_K_M.gguf

# --- App Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
